{
  "name": "buglab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run monaco:copy",
    "dev": "next dev",
    "prebuild": "npm run monaco:copy",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypegen": "npm run monaco:copy",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "monaco:copy": "node scripts/monaco-assets.mjs copy",
    "monaco:verify": "node scripts/monaco-assets.mjs verify",
    "test": "node --import ./tests/setup/register.mjs --test \"tests/**/*.test.ts\"",
    "auth:schema": "node --import ./tests/setup/register.mjs scripts/account-schema.ts",
    "test:auth": "node --import ./tests/setup/register.mjs --test \"tests/auth/*.test.ts\" \"tests/account/*.test.ts\"",
    "test:auth:browser": "playwright test --config playwright.auth.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:db": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@monaco-editor/react": "^4.7.0",
    "better-auth": "1.7.18",
    "monaco-editor": "0.57.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
